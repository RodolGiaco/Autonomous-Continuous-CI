{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(claude *)",
      "Bash(gh auth *)",
      "Bash(gh repo delete *)",
      "Bash(gh api *)",
      "Read(.env)",
      "Edit(.env)"
    ],
    "ask": [
      "Edit(/kit/**)",
      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)"
    ],
    "allow": [
      "Bash",
      "Skill",
      "Edit(/src/**)",
      "Write(/src/**)",
      "Edit(/docs/**)",
      "Write(/docs/**)",
      "Edit(/openspec/**)",
      "Write(/openspec/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-push.sh",
            "args": [],
            "if": "Bash(git *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commit.sh",
            "args": [],
            "if": "Bash(git *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-merge.sh",
            "args": [],
            "if": "Bash(gh *)",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
