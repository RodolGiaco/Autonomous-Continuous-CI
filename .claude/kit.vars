# Single per-project file. Every hook and script reads from here.
# Nothing else in the kit contains a project-specific value.
# Values with spaces must be quoted: this file is sourced, not parsed.

# Branch that only changes through a pull request merged by GitHub.
KIT_MAIN_BRANCH=main

# Prefix of the branch the cycle creates for each issue.
# Expected shape: <prefix><number>-<slug>
KIT_ISSUE_BRANCH_PREFIX=issue/

# Prefix of the lane used to repair the kit itself, which is not an issue.
# Expected shape: <prefix><slug>
KIT_MAINTENANCE_BRANCH_PREFIX=kit/

# Project commands. Empty means the step is skipped.
KIT_JAVA_VERSION=21
KIT_FORMAT_CHECK_CMD="mvn -B -q spotless:check"
KIT_TEST_CMD="mvn -B test"
KIT_SPEC_CHECK_CMD="bash scripts/spec-check.sh"
